  "metric_contract": {
    "fixed_point_scale": 1000000,
    "metric_definitions": {
      "ambiguous_status_success_count": "count of six ambiguous tasks returning uncertain with multi-target coverage and no oracle-negative target",
      "answerable_target_success_count": "count of the 42 answerable tasks with at least one oracle-valid primary target under the frozen task-kind rule",
      "cold_index_p95_us": "parent-observed p95 cold prepare/index duration in integer microseconds",
      "component_subset_success_counts": "target/status success counts within the predeclared literal, symbol, graph, and support subsets; support subset success equals support success",
      "context_f05_sum_ppm": "sum over 42 answerable tasks of span F0.5 stored as integer millionths; rank uses the sum, never a rounded mean",
      "harmful_evidence_task_count": "count of answerable tasks whose selected evidence overlaps a frozen oracle-negative span",
      "index_state_p95_bytes": "p95 sealed persistent-state bytes after cold build",
      "no_answer_status_success_count": "count of six no-answer tasks returning no_evidence with no selected candidate/evidence/target/support",
      "one_shot_success_count": "count of 36 one-shot tasks meeting the frozen status and target rule",
      "peak_rss_p95_bytes": "parent-observed p95 peak resident bytes over attempted stages",
      "support_success_count": "count of 12 two-step tasks with a correct bound parent target and at least one oracle-valid bounded support relation",
      "task_success_count": "count of the 48 logical tasks whose frozen status/target and, when applicable, support requirements all pass",
      "warm_query_p95_us": "parent-observed warm query-to-pack p95 in integer microseconds over technical repetitions"
    },
    "no_opaque_single_composite_score": true,
    "quality_and_resource_ranks_reported_separately": true,
    "quality_semantics_must_match_across_cache_and_repetitions": true,
    "resource_samples_are_repeated_measurements_not_independent_tasks": true,
    "scoring_rules": {
      "abstain_success": "status_no_evidence_and_zero_candidates_evidence_targets_and_support",
      "cold_index_population": "one_cold_context_prepare_per_repository_arm_repetition",
      "component_subset_success": "target_or_status_success_inside_the_frozen_component_eligible_subset;_for_support_the_value_is_support_success_count",
      "context_empty_answerable_value": 0,
      "context_f05": "1.25_times_precision_times_recall_divided_by_0.25_times_precision_plus_recall",
      "context_precision": "positive_selected_line_atoms_divided_by_selected_line_atoms",
      "context_recall": "positive_selected_line_atoms_divided_by_positive_oracle_line_atoms",
      "context_sum_denominator_tasks": 42,
      "deterministic_target_success": "selected_primary_target_intersects_the_single_positive_target_span_and_intersects_no_negative_span",
      "duplicate_selected_line_atoms_deduplicated_before_scoring": true,
      "fixed_point_conversion": "floor_exact_rational_times_1000000",
      "harmful_evidence_task": "any_selected_line_atom_intersects_any_frozen_negative_span",
      "index_state_population": "sealed_persistent_index_bytes_after_each_cold_context_build",
      "line_atom": "canonical_relative_path_plus_one_indexed_line",
      "logical_task_success_partition": "task_success_count_equals_one_shot_success_count_plus_support_success_count",
      "multi_target_success": "status_uncertain_and_at_least_two_distinct_positive_target_spans_covered_and_no_selected_target_intersects_a_negative_span",
      "no_answer_tasks_excluded_from_context_f05_sum": true,
      "parent_unavailable": "support_success_false_and_task_success_false",
      "peak_rss_population": "all_attempted_validated_records_parent_observed_direct_worker_peak_rss",
      "quality_analysis_unit": "logical_task_after_four_technical_repetitions_agree",
      "quality_scored_once_per_logical_task_after_exact_cache_repetition_semantic_equality": true,
      "resource_percentile_rule": "nearest_rank_ceiling_p95",
      "resource_query_population": "executed_adapter_queries_only;_terminal_support_opportunities_excluded",
      "resource_rss_population": "executed_adapter_records_only;_terminal_parent_wrapper_rss_excluded",
      "target_divergence": "not_a_failure_gate_and_not_normalized",
      "terminal_support_count": "reported_separately_and_never_rewards_quality",
      "two_step_context_target": "score_each_arm_against_the_frozen_oracle_using_that_arms_own_context_target",
      "two_step_parent_normalization": "all_six_context_targets_must_share_one_path_and_a_nonempty_line_range_intersection;_the_exact_intersection_is_the_common_parent_for_all_six_support_requests;_otherwise_the_run_fails_closed",
      "two_step_step_order": "all_six_context_steps_in_frozen_arm_order_then_all_six_support_steps_in_same_order",
      "two_step_support": "context_target_success_and_same_arm_parent_lineage_valid_and_at_least_one_selected_support_span_matches_a_frozen_relation",
      "two_step_support_success": "context_target_success_and_parent_lineage_valid_and_at_least_one_selected_support_span_matches_a_frozen_target_relation_span",
      "warm_query_population": "all_warm_context_and_support_records_query_plus_materialize_plus_render"
    },
